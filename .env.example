# ============================================================
# AI Debt OS — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI provider (required) ───────────────────────────────────
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ── Application Security (required) ─────────────────────────
# Generate: openssl rand -base64 32
APP_SECRET=your-random-secret-minimum-32-characters-here

# Your deployed application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.example

# ── WAHA (WhatsApp HTTP API) — primary WhatsApp gateway ─────
# Self-hosted WAHA instance (https://waha.devlike.pro).
# Used for both sending and receiving (inbound webhook → /api/whatsapp/waha-webhook).
WAHA_API_URL=http://your-waha-host:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=your-long-random-waha-webhook-secret
# JSON object: every inbound WAHA session must map to one company UUID.
WAHA_SESSION_COMPANY_MAP={"default":"00000000-0000-0000-0000-000000000001"}

# HTTPS public hosts allowed for administrator-configured integrations.
INTEGRATION_ALLOWED_HOSTS=api.partner.example

# ── Rasf/InSync inbound webhook (optional) ─────────────────
# Both values are required together. The map key is the inbound payload's
# instance/session/recipient/to routing value.
# RASF_WEBHOOK_SECRET=your-long-random-rasf-webhook-secret
# RASF_WEBHOOK_COMPANY_MAP={"rasf-instance":"00000000-0000-0000-0000-000000000001"}

# ── n8n (optional) ──────────────────────────────────────────
# N8N_BASE_URL=http://127.0.0.1:5678
# N8N_API_KEY=your-n8n-api-key
# N8N_WEBHOOK_SECRET=your-long-random-n8n-webhook-secret

# ── Optional inbound email channel ───────────────────────────
# Leave unset to keep the route disabled (503).
# EMAIL_INBOUND_SECRET=your-long-random-email-webhook-secret
# EMAIL_INBOUND_COMPANY_MAP={"collections+tenant@example.com":"00000000-0000-0000-0000-000000000001"}

# ── Optional cron caller secret ──────────────────────────────
# CRON_SECRET=your-long-random-cron-secret
